rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Helper untuk mengecek role dari dokumen user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "armin.gandi@gmail.com" || 
        (userExists() && 'role' in getUserData() && getUserData().role == "superadmin")
      );
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "armin.gandi@gmail.com" || 
        (userExists() && 'role' in getUserData() && getUserData().role in ["superadmin", "admin"])
      );
    }
    
    function isDemo() { 
      return isSignedIn() && userExists() && 'role' in getUserData() && getUserData().role == "demo"; 
    }
    
    function isAdminOrDemo() { return isAdmin() || isDemo(); }
    
    function isBanned() { 
      return isSignedIn() && userExists() && 'isBanned' in getUserData() && getUserData().isBanned == true; 
    }
    
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 256 &&
             data.role is string && data.role in ["superadmin", "admin", "staff", "crew", "demo", "demouser"] && 
             data.createdAt is number && 
             data.avatarUrl is string && data.avatarUrl.size() <= 2048 &&
             data.shiftId is string && data.shiftId.size() <= 128 &&
             data.uniqueId is string && data.uniqueId.size() <= 128 &&
             (!('areaId' in data) || data.areaId == null || (data.areaId is string && data.areaId.size() <= 128)) &&
             (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128)) &&
             (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 128)) &&
             (!('subareaId' in data) || data.subareaId == null || (data.subareaId is string && data.subareaId.size() <= 128)) &&
             (!('isBanned' in data) || data.isBanned is bool) &&
             (!('fcmToken' in data) || data.fcmToken is string) &&
             (!('deviceId' in data) || data.deviceId is string && data.deviceId.size() <= 256) &&
             (!('waNumber' in data) || data.waNumber == null || (data.waNumber is string && data.waNumber.size() <= 20));
    }

    function isValidAttendance(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.timestamp is number &&
             data.type is string && data.type in ["in", "out", "overtime_in", "overtime_out", "sick", "permit", "cuti", "melahirkan", "meninggal", "dispensasi"] &&
             data.method is string && data.method in ["selfie", "qr", "admin", "rfid"] &&
             data.status is string && data.status in ["approved", "pending_approval", "rejected"] &&
             (!('photoBase64' in data) || data.photoBase64 == null || (data.photoBase64 is string && data.photoBase64.size() <= 2000000)) &&
             (!('extraData' in data) || data.extraData == null || (data.extraData is string && data.extraData.size() <= 256)) &&
             (!('location' in data) || data.location == null || (data.location is map)) &&
             (!('withinRadius' in data) || data.withinRadius == null || data.withinRadius is bool) &&
             (!('deviceOwnerUid' in data) || data.deviceOwnerUid == null || (data.deviceOwnerUid is string && data.deviceOwnerUid.size() <= 128)) &&
             (!('deviceOwnerName' in data) || data.deviceOwnerName == null || (data.deviceOwnerName is string && data.deviceOwnerName.size() <= 128));
    }

    function isValidLeaveRequest(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.startDate is number &&
             data.endDate is number &&
             data.type is string && data.type.size() <= 128 &&
             data.status is string && data.status in ["pending", "approved", "rejected"] &&
             data.notes is string && data.notes.size() <= 2048;
    }

    function isValidPayrollRecord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.month is number &&
             data.year is number &&
             data.salaryAmount is number &&
             data.status is string && data.status.size() <= 64;
    }
    
    function isValidSettings(data) {
      return (!('geofenceEnabled' in data) || data.geofenceEnabled is bool) &&
             (!('appName' in data) || data.appName is string) &&
             (!('appLogoUrl' in data) || data.appLogoUrl is string) &&
             (!('fcmVapidKey' in data) || data.fcmVapidKey is string) &&
             (!('shifts' in data) || data.shifts is map) &&
             (!('areas' in data) || data.areas is map) &&
             (!('holidays' in data) || data.holidays is list);
    }
    
    function isValidApiSettings(data) {
      return (!('googleMapsApiKey' in data) || data.googleMapsApiKey is string);
    }

    function isValidIdRef(data) {
      return data.used is bool &&
             (!('usedBy' in data) || data.usedBy == null || (data.usedBy is string && data.usedBy.size() <= 128)) &&
             (!('usedAt' in data) || data.usedAt == null || data.usedAt is number) &&
             (!('role' in data) || data.role == null || (data.role is string && data.role in ["superadmin", "admin", "staff", "crew", "demo", "demouser"])) &&
             (!('shiftId' in data) || data.shiftId == null || (data.shiftId is string && data.shiftId.size() <= 128)) &&
             (!('areaId' in data) || data.areaId == null || (data.areaId is string && data.areaId.size() <= 128)) &&
             (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128)) &&
             (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 128)) &&
             (!('subareaId' in data) || data.subareaId == null || (data.subareaId is string && data.subareaId.size() <= 128));
    }

    // Validations for Hierarchy
    function isValidArea(data) {
      return data.name is string && data.name.size() <= 128 &&
             (!('lat' in data) || data.lat is number) && 
             (!('lng' in data) || data.lng is number) && 
             (!('radius' in data) || data.radius is number);
    }

    function isValidCompany(data) {
      return data.name is string && data.name.size() <= 128 &&
             (!('areaId' in data) || data.areaId == null || (data.areaId is string && data.areaId.size() <= 128));
    }

    function isValidBranch(data) {
      return data.name is string && data.name.size() <= 128 &&
             (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128)) &&
             (!('areaId' in data) || data.areaId == null || (data.areaId is string && data.areaId.size() <= 128));
    }

    function isValidSubArea(data) {
      return data.name is string && data.name.size() <= 128 &&
             (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 128)) &&
             (!('lat' in data) || data.lat is number) && 
             (!('lng' in data) || data.lng is number) && 
             (!('radius' in data) || data.radius is number);
    }

    // Default Deny All
    match /{document=**} { allow read, write: if false; }

    // Areas Collection
    match /areas/{areaId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidArea(incoming());
      allow delete: if isAdmin();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCompany(incoming());
      allow delete: if isAdmin();
    }

    // Branches Collection
    match /branches/{branchId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBranch(incoming());
      allow delete: if isAdmin();
    }

    // SubAreas Collection
    match /subareas/{subareaId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSubArea(incoming());
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdminOrDemo());
      allow list: if isAdminOrDemo();
      allow create: if request.auth != null && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) &&
                    (
                      isSuperAdmin() ||
                      (isOwner(userId) && !isBanned() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'waNumber', 'avatarUrl', 'fcmToken', 'deviceId']) && incoming().uid == existing().uid) ||
                      (isAdmin() &&
                       get(/databases/$(database)/documents/users/$(userId)).data.role != 'superadmin' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'waNumber', 'avatarUrl', 'role', 'shiftId', 'uniqueId', 'areaId', 'companyId', 'branchId', 'subareaId', 'isBanned', 'fcmToken', 'deviceId']) &&
                       incoming().uid == existing().uid
                      )
                    );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId) && (isOwner(resource.data.userId) || isAdminOrDemo());
      allow list: if isSignedIn() && (isAdminOrDemo() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(attendanceId) && isSignedIn() && !isBanned() && isValidAttendance(incoming()) && 
                    (incoming().userId == request.auth.uid || (incoming().method == 'qr' && incoming().deviceOwnerUid == request.auth.uid) || isAdmin()) &&
                    exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if isValidId(attendanceId) && isAdmin() && isValidAttendance(incoming()) &&
                    (
                      isSuperAdmin() ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'photoBase64'])
                    );
      allow delete: if isValidId(attendanceId) && isAdmin();
    }

    // LeaveRequests Collection
    match /leaveRequests/{requestId} {
      allow get: if isValidId(requestId) && (isOwner(resource.data.userId) || isAdminOrDemo());
      allow list: if isSignedIn() && (isAdminOrDemo() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(requestId) && isSignedIn() && !isBanned() && isValidLeaveRequest(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isValidId(requestId) && isAdmin() && isValidLeaveRequest(incoming());
    }

    // Payroll Collection
    match /payroll/{payrollId} {
      allow get: if isValidId(payrollId) && (isOwner(resource.data.userId) || isAdminOrDemo());
      allow list: if isSignedIn() && (isAdminOrDemo() || resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(payrollId) && isAdmin() && isValidPayrollRecord(incoming());
      allow delete: if isValidId(payrollId) && isAdmin();
    }

    // Settings Collection
    match /settings/global {
      allow get: if true;
      allow list: if true;
      allow create, update: if isAdmin() && isValidSettings(incoming());
      allow delete: if false;
    }

    // Protected API Settings Collection
    match /settings_private/api {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidApiSettings(incoming());
      allow delete: if false;
    }

    // Admins Collection
    match /admins/{uid} {
      allow get: if isValidId(uid) && isAdminOrDemo();
      allow list: if isAdminOrDemo();
      allow write: if false; // Manually added
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidId(notificationId);
      allow update: if isValidId(notificationId) && isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // Security Logs Collection
    match /securityLogs/{logId} {
      allow get: if isValidId(logId) && isAdminOrDemo();
      allow list: if isAdminOrDemo();
      allow create: if isSignedIn(); // Allow system to write logs
      allow update, delete: if false;
    }

    // IdRefs Collection
    match /idRefs/{refId} {
      allow get: if isValidId(refId); 
      allow list: if isAdminOrDemo();
      allow create: if isValidId(refId) && isAdmin() && isValidIdRef(incoming());
      allow delete: if isValidId(refId) && isAdmin();
      allow update: if isValidId(refId) && isSignedIn() && isValidIdRef(incoming()) &&
                    (
                       (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt', 'role', 'shiftId', 'areaId', 'companyId', 'branchId', 'subareaId'])) ||
                       (!existing().used && incoming().used == true && incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']))
                    );
    }
  }
}
