{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Company profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Division": {
      "title": "Division",
      "description": "Company division",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyId": { "type": "string" }
      },
      "required": ["name", "companyId"]
    },
    "WorkHourSetting": {
      "title": "WorkHourSetting",
      "description": "Rules for working hours",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startEarlyAbsen": { "type": "string" },
        "startLimitAbsen": { "type": "string" },
        "startWork": { "type": "string" },
        "endWork": { "type": "string" },
        "toleranceMinutes": { "type": "number" },
        "activeDays": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name"]
    },
    "DivisionShiftAssignment": {
      "title": "DivisionShiftAssignment",
      "description": "Assignment of shifts to divisions",
      "type": "object",
      "properties": {
        "divisionId": { "type": "string" },
        "shiftId": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" }
      },
      "required": ["divisionId", "shiftId", "startDate", "endDate"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "admin", "staff", "crew"] },
        "avatarUrl": { "type": "string" },
        "shiftId": { "type": "string" },
        "divisionId": { "type": "string" },
        "uniqueId": { "type": "string" },
        "waNumber": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "uniqueId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance log record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out", "overtime_in", "overtime_out", "sick", "permit", "cuti", "melahirkan", "meninggal"] },
        "method": { "type": "string", "enum": ["selfie", "qr"] },
        "photoBase64": { "type": "string" },
        "location": { "type": "object" },
        "withinRadius": { "type": "boolean" },
        "extraData": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending_approval", "rejected"] },
        "deviceOwnerUid": { "type": "string" },
        "deviceOwnerName": { "type": "string" }
      },
      "required": ["userId", "timestamp", "type", "method", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System-wide application settings",
      "type": "object",
      "properties": {
        "geofenceEnabled": { "type": "boolean" },
        "shifts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/entities/Shift"
          }
        }
      }
    },
    "Shift": {
      "title": "Shift",
      "description": "Work shift definition",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startTime": { "type": "string", "description": "Default start time HH:mm" },
        "endTime": { "type": "string", "description": "Default end time HH:mm" },
        "gracePeriod": { "type": "number", "description": "Minutes allowed late" },
        "color": { "type": "string" },
        "workDays": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          }
        }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator",
      "type": "object",
      "properties": {
        "uid": { "type": "string" }
      },
      "required": ["uid"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "User leave or permit requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "notes": { "type": "string" }
      },
      "required": ["userId", "startDate", "endDate", "type", "status"]
    },
    "PayrollRecord": {
      "title": "PayrollRecord",
      "description": "User payroll information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "salaryAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["userId", "month", "year", "salaryAmount", "status"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Company registration"
    },
    "/divisions/{divisionId}": {
      "schema": "Division",
      "description": "Company divisions"
    },
    "/workHourSettings/{settingId}": {
      "schema": "WorkHourSetting",
      "description": "Working hour configurations"
    },
    "/divisionShiftAssignments/{assignmentId}": {
      "schema": "DivisionShiftAssignment",
      "description": "Mass shift assignments"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Records of attendance entries"
    },
    "/leaveRequests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "User leave/permit requests"
    },
    "/payroll/{payrollId}": {
      "schema": "PayrollRecord",
      "description": "User payroll records"
    },
    "/settings/global": {
      "schema": "Settings",
      "description": "Global application configuration"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "System administrators by UID"
    }
  }
}
